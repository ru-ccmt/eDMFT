 stop:					#normal exit
+# STRT/STRFT use the native STR/STRF path in LAPW2.  Once the ordinary
+# charge loop has converged, compute the screened response from the last
+# pre-MIXER density (case.clmsum_old).  This keeps response work out of every
+# SCF cycle and leaves the live LAPW0/LAPW1/LAPW2 files untouched.
+set dft_response_mode = `head -1 $file.in2$complex2 | awk '{print $1}'`
