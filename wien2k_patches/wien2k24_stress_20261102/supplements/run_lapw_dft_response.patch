+      echo "STRT/STRFT requires WIEN_DMFT_ROOT for dft_stress_step.py" | tee -a $dayfile
+      exit 9
+   endif
+   $WIEN_DMFT_ROOT/dft_stress_step.py --case $file --wien-root $WIENROOT >>& $dayfile
