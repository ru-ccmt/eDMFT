+subroutine rela_pulay_d_corr(nemin,nemax,jatom,alm,blm,clm, &
+                             capd0lm,capd1lm,buf_corr)
+   ! Exact scalar-relativistic replacement of the matching-coefficient
+   ! (D) part of the spherical incomplete-basis correction.
+   !
+   ! For an energy-independent Hamiltonian and a radial solution u_j made
+   ! at E_j one may use
+   !
+   !   <u_i | H-epsilon | u_j> = (E_j-epsilon)<u_i|u_j> .
+   !
+   ! VAL_CORR_STRESS uses this identity, including the usual udot and LO
+   ! derivatives.  In CALC=RELA, however,
+   !
+   !   H_SR(epsilon) = -div[A(r,epsilon) grad] + V,
+   !   A(r,epsilon)  = 1/[1+(epsilon-V)/(4c^2)],
+   !
+   ! and the operator tested at the band energy is not the operator that
+   ! generated a radial basis function at E_l or E_LO.  This routine
+   ! evaluates the strong radial matrix element directly for the large
+   ! component and returns exact minus the historical two-component
+   ! identity.  Adding the difference leaves NREL bitwise unchanged.
+   !
+   ! The weak radial form is used for numerical stability and its outer
+   ! boundary term is subtracted explicitly:
+   !
+   ! F_ij = int_0^R dr r^2 { A_eps[f_i' f_j'
+   !                    +l(l+1)f_i f_j/r^2]+(V-eps)f_i f_j }
+   !        - R^2 f_i(R) A_eps(R) f_j'(R).
+   !
+   ! CAPD0/1 are the already validated derivatives of the APW matching
+   ! coefficients.  Only their bra-side contraction belongs to this first
+   ! Pulay line; radial-coordinate and angular Pulay responses are separate
+   ! terms and are deliberately not mixed into this diagnostic.
+
+   use param
+   use com, only: rel
+   use struk, only: r0,dx,jri
+   use atspdt, only: el,pei
+   use xa, only: e
+   use radial_functions, only: vr,rrad1,rade1,radp1,radpe1
+   use lo, only: ilo,loor,elo,a1lo,ap1lo
+   use stress_kb, only: jlaplo1_02,jlaplo1_12
+   implicit none
+
+   integer, intent(in) :: nemin,nemax,jatom
+   complex*16, intent(in) :: alm((lmax2+1)*(lmax2+1),nume), &
+                             blm((lmax2+1)*(lmax2+1),nume), &
+                             clm((lmax2+1)*(lmax2+1),nume,nloat)
+   complex*16, intent(in) :: capd0lm(3,3,(lmax2+1)*(lmax2+1),nume), &
+                             capd1lm(3,3,(lmax2+1)*(lmax2+1),nume)
+   complex*16, intent(out) :: buf_corr(3,3,nume)
+
+   integer :: imax,l,m,lm,num,alpha,beta,jlo,ich,nchan,ir,ibra,jket
+   real*8 :: c_atomic,me,r,vpot,aeps,eps,llp1,sumf,boundary
+   complex*16 :: exact_value,old_value,ket_coeff
+   real*8, allocatable :: rmesh(:),funct(:)
+   real*8, allocatable :: f(:,:,:),df(:,:,:),fmat(:,:)
+
+   buf_corr=(0.d0,0.d0)
+   if(.not.rel) return
+
+   imax=jri(jatom)
+   nchan=nloat+2
+   allocate(rmesh(imax),funct(imax))
+   allocate(f(imax,0:lmax2n,nchan),df(imax,0:lmax2n,nchan))
+   allocate(fmat(2,nchan))
+   do ir=1,imax
+      rmesh(ir)=r0(jatom)*exp(dx(jatom)*dble(ir-1))
+   enddo
+
+   f=0.d0
+   df=0.d0
+   do l=0,lmax2n
+      f(:,l,1)=rrad1(1:imax,l)/rmesh
+      f(:,l,2)=rade1(1:imax,l)/rmesh
+      df(:,l,1)=radp1(1:imax,l)/rmesh
+      df(:,l,2)=radpe1(1:imax,l)/rmesh
+      do jlo=1,ilo(l)
+         if(.not.loor(jlo,l)) cycle
+         ich=2+jlo
+         f(:,l,ich)=a1lo(1:imax,jlo,l)/rmesh
+         df(:,l,ich)=ap1lo(1:imax,jlo,l)/rmesh
+      enddo
+   enddo
+
+   c_atomic=137.0359895d0
+   me=1.d0/(4.d0*c_atomic*c_atomic)
+
+   do num=nemin,nemax
+      eps=e(num)
+      do l=0,lmax2n
+         llp1=dble(l*(l+1))
+         fmat=0.d0
+         do ibra=1,2
+            do jket=1,nchan
+               ! Channels beyond the actual LO count for this l remain
+               ! identically zero and are harmless, but skip them to avoid
+               ! unnecessary radial integrations.
+               if(jket.gt.2) then
+                  jlo=jket-2
+                  if(jlo.gt.ilo(l)) cycle
+                  if(.not.loor(jlo,l)) cycle
+               endif
+               do ir=1,imax
+                  r=rmesh(ir)
+                  vpot=2.d0*vr(ir)/r
+                  aeps=1.d0/(1.d0+(eps-vpot)*me)
+                  funct(ir)=r*r*(aeps*(df(ir,l,ibra)*df(ir,l,jket)+ &
+                       llp1*f(ir,l,ibra)*f(ir,l,jket)/(r*r))+ &
+                       (vpot-eps)*f(ir,l,ibra)*f(ir,l,jket))
+               enddo
+               call charge(rmesh,dx(jatom),funct,1,imax,sumf)
+               r=rmesh(imax)
+               vpot=2.d0*vr(imax)/r
+               aeps=1.d0/(1.d0+(eps-vpot)*me)
+               boundary=r*r*f(imax,l,ibra)*aeps*df(imax,l,jket)
+               fmat(ibra,jket)=sumf-boundary
+            enddo
+         enddo
+
+         do m=-l,l
+            lm=l*(l+1)+m+1
+            do alpha=1,3
+               do beta=1,3
+                  exact_value=conjg(capd0lm(alpha,beta,lm,num))*( &
+                       alm(lm,num)*fmat(1,1)+ &
+                       blm(lm,num)*fmat(1,2)) + &
+                       conjg(capd1lm(alpha,beta,lm,num))*( &
+                       alm(lm,num)*fmat(2,1)+ &
+                       blm(lm,num)*fmat(2,2))
+                  do jlo=1,ilo(l)
+                     if(.not.loor(jlo,l)) cycle
+                     ich=2+jlo
+                     exact_value=exact_value+clm(lm,num,jlo)*( &
+                          conjg(capd0lm(alpha,beta,lm,num))* &
+                          fmat(1,ich)+ &
+                          conjg(capd1lm(alpha,beta,lm,num))* &
+                          fmat(2,ich))
+                  enddo
+
+                  ! Reproduce exactly the historical first-line identity
+                  ! from VAL_CORR_STRESS so the returned tensor is a pure
+                  ! RELA replacement and contains no duplicated NREL term.
+                  old_value=(el(l)-eps)*( &
+                       conjg(capd0lm(alpha,beta,lm,num))*alm(lm,num)+ &
+                       conjg(capd1lm(alpha,beta,lm,num))* &
+                       blm(lm,num)*pei(l)) + &
+                       conjg(capd0lm(alpha,beta,lm,num))*blm(lm,num)
+                  do jlo=1,ilo(l)
+                     if(.not.loor(jlo,l)) cycle
+                     old_value=old_value+( &
+                          conjg(capd0lm(alpha,beta,lm,num))* &
+                          jlaplo1_02(jlo,l)+ &
+                          conjg(capd1lm(alpha,beta,lm,num))* &
+                          jlaplo1_12(jlo,l))* &
+                          (elo(l,jlo)-eps)*clm(lm,num,jlo)
+                  enddo
+                  buf_corr(alpha,beta,num)=buf_corr(alpha,beta,num)+ &
+                                             exact_value-old_value
+               enddo
+            enddo
+         enddo
+      enddo
+   enddo
+
+   deallocate(rmesh,funct,f,df,fmat)
+end subroutine rela_pulay_d_corr
