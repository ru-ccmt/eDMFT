+ real*8::t0,t1,t2
+ key_real=[dble(jatom),dble(size(rmesh)),dble(size(lf,2)),dble(size(lf,3)),dx,merge(1.d0,0.d0,SimpInt),merge(1.d0,0.d0,ConOpt),old_scale,surf_scale,en_scale,nat_scale,mass_scale, &
+    dble(ilo),reshape(merge(1.d0,0.d0,loor),[size(loor)]), &
+    rmesh,dvry,reshape(lf,[size(lf)]),reshape(ldf,[size(ldf)]), &
+    reshape(sf,[size(sf)]),reshape(sdf,[size(sdf)]), &
+    reshape(qd,[size(qd)]),reshape(qu,[size(qu)])]
+ new_key=transfer(key_real,[0_8],size(key_real))
+ refresh=.true.
+ if(allocated(input_key)) then
+    if(size(input_key).eq.size(new_key)) refresh=any(input_key.ne.new_key)
+ endif
+ call cpu_time(t0)
