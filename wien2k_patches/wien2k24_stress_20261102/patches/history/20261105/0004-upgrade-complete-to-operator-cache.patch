+                   enddo
+                enddo
+             enddo
+          enddo
+       enddo
+    enddo
+ endif
+ nbasis=0
+ do l=0,lmax
+    nbasis=nbasis+(2*l+1)*count(lookup(l,:).ne.0)
+ enddo
+ if(allocated(basis_lm)) deallocate(basis_lm,basis_ch,pair_p,pair_q,operators,overlap)
+ allocate(basis_lm(nbasis),basis_ch(nbasis),br(nbasis),first(nin),last(nin))
+ p=0
+ do lm=1,nin
+    l=int(sqrt(dble(lm-1)));first(lm)=p+1
+    do ch=1,nchan
+       if(lookup(l,ch).eq.0) cycle
+       p=p+1;basis_lm(p)=lm;basis_ch(p)=ch;br(p)=lookup(l,ch)
+    enddo
+    last(lm)=p
+ enddo
+ maxpairs=nbasis*nbasis
+ allocate(pair_p(maxpairs),pair_q(maxpairs),operators(9,5,maxpairs),overlap(maxpairs))
+ npairs=0;rsq=r(nr)*r(nr)
+ do iq=1,nin
+    do ip=1,nin
+       aa=(0.d0,0.d0);mm=(0.d0,0.d0)
+       do j=1,2
+          do i=1,2
+             do b=1,3
+                do a=1,3
+                   aa(a,b,i,j)=0.5d0*sum(conjg(angular(:,a,i,ip))*angular(:,b,j,iq)+ &
+                                                conjg(angular(:,b,i,ip))*angular(:,a,j,iq))
+                   if(mass_scale.ne.0.d0) then
+                      do v=1,3
+                         mm(a,b,i,j)=mm(a,b,i,j)+0.5d0*sum( &
+                            conjg(moment(:,a,v,i,ip))*moment(:,b,v,j,iq)+ &
+                            conjg(moment(:,b,v,i,ip))*moment(:,a,v,j,iq))
+                      enddo
+                   endif
+                enddo
+             enddo
+          enddo
+       enddo
+       if(all(aa.eq.(0.d0,0.d0)).and.all(mm.eq.(0.d0,0.d0)).and.ip.ne.iq) cycle
+       do q=first(iq),last(iq)
+          do p=first(ip),last(ip)
+             lp=br(p);lq=br(q);op=(0.d0,0.d0)
+             do b=1,3
+                do a=1,3
+                   t=a+3*(b-1)
+                   do j=1,2
+                      do i=1,2
+                         ang=aa(a,b,i,j)
+                         op(t,1)=op(t,1)+0.5d0*ang*(rad(i,j,lp,lq,2)+rad(j,i,lq,lp,2))
+                         op(t,2)=op(t,2)+ang*(rad(i,j,lp,lq,1)+old_scale*c2inv*rad(i,j,lp,lq,3))
+                         if(nat_scale.ne.0.d0) op(t,5)=op(t,5)+me*ang*rad(i,j,lp,lq,4)
+                         if(mass_scale.ne.0.d0) op(t,4)=op(t,4)+me*mm(a,b,i,j)*rad(i,j,lp,lq,5)
+                      enddo
+                   enddo
+                   if(mass_scale.ne.0.d0) op(t,4)=op(t,4)-c2inv*aa(a,b,1,1)*rs(lp,lq,1)
+                   op(t,3)=rsq*aa(a,b,1,1)*lf(nr,rl(lp),rc(lp))* &
+                              (qd(nr,rl(lq),rc(lq))-ldf(nr,rl(lq),rc(lq)))
+                   if(surf_scale.ne.0.d0) then
+                      do j=1,2
+                         op(t,3)=op(t,3)+surf_scale*rsq*c2inv*small(nr,lp)*aa(a,b,1,j)*sv(nr,j,lq)
+                      enddo
+                   endif
+                enddo
+             enddo
+             ev=0.d0
+             if(en_scale.ne.0.d0.and.ip.eq.iq) ev=rs(lp,lq,2)
+             if(all(op.eq.(0.d0,0.d0)).and.ev.eq.0.d0) cycle
+             npairs=npairs+1;pair_p(npairs)=p;pair_q(npairs)=q
+             operators(:,:,npairs)=op;overlap(npairs)=ev
+          enddo
+       enddo
+    enddo
+ enddo
+end subroutine
+end module rela_operator_cache
