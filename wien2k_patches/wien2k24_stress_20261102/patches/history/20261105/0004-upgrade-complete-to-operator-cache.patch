+ implicit none
+ integer,intent(in)::nemin,nemax,jatom,nmap(:),outmap(:,:),nmap2(:),outmap2(:,:)
+ complex*16,intent(in)::alm(:,:),blm(:,:),clm(:,:,:),hmap(:,:,:),dmap(:,:,:),hmap2(:,:,:)
+ real*8,intent(in)::rmesh(:),dx,lf(:,0:,:),ldf(:,0:,:),sf(:,0:,:),sdf(:,0:,:), &
+    qd(:,0:,:),qu(:,0:,:),dvry(:),old_scale,surf_scale,en_scale,nat_scale,mass_scale,band_energy(:)
+ complex*16,intent(out)::buf_corr(:,:,:),buf_sr(:,:,:),buf_old(:,:,:),buf_surf(:,:,:)
+ real*8,allocatable::key_real(:)
