+!$omp parallel default(shared) private(num,coeff,p,q,k,a,b,t,u,product,sums,norm_value)
+ allocate(coeff(nbasis))
+!$omp do schedule(dynamic,1)
+ do num=nemin,nemax
+    do p=1,nbasis
+       if(basis_ch(p).eq.1) then
