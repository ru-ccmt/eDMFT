+subroutine build_operators(r,dx,lf,ldf,sf,sdf,qd,qu,dvry, &
+    nmap,outmap,hmap,dmap,nmap2,outmap2,hmap2,old_scale,surf_scale,en_scale,nat_scale,mass_scale)
+ use lo, only: ilo,loor
+ implicit none
+ integer,intent(in)::nmap(:),outmap(:,:),nmap2(:),outmap2(:,:)
+ complex*16,intent(in)::hmap(:,:,:),dmap(:,:,:),hmap2(:,:,:)
+ real*8,intent(in)::r(:),dx,lf(:,0:,:),ldf(:,0:,:),sf(:,0:,:),sdf(:,0:,:), &
+    qd(:,0:,:),qu(:,0:,:),dvry(:),old_scale,surf_scale,en_scale,nat_scale,mass_scale
+ real*8,allocatable::gv(:,:,:),fv(:,:,:),sv(:,:,:),small(:,:),rad(:,:,:,:,:),rs(:,:,:),fun(:)
+ integer,allocatable::rl(:),rc(:),lookup(:,:),br(:),first(:),last(:)
+ complex*16,allocatable::angular(:,:,:,:),moment(:,:,:,:,:)
+ complex*16::aa(3,3,2,2),mm(3,3,2,2),op(9,5),ang
+ real*8::c2inv,me,rsq,rr,ev
+ integer::nr,lmax,nin,nout,nout2,nchan,nlc,l,m,lm,ch,z,p,q,ip,iq,lp,lq, &
+          i,j,a,b,v,k,w,out,output,t,iu,iv,maxpairs
+ nr=size(r);lmax=ubound(lf,2);nchan=size(lf,3)
+ nin=size(nmap);nout=size(nmap2);nout2=(lmax+3)**2
+ c2inv=1.d0/(137.0359895d0**2);me=0.25d0*c2inv
+ allocate(lookup(0:lmax,nchan));lookup=0
+ nlc=0
+ do l=0,lmax
+    do ch=1,nchan
+       if(ch.gt.2) then
+          if(ch-2.gt.ilo(l)) cycle
+          if(.not.loor(ch-2,l)) cycle
+       endif
+       nlc=nlc+1;lookup(l,ch)=nlc
+    enddo
+ enddo
+ allocate(rl(nlc),rc(nlc),gv(nr,2,nlc),fv(nr,2,nlc),sv(nr,2,nlc),small(nr,nlc))
+ do l=0,lmax
+    do ch=1,nchan
+       z=lookup(l,ch);if(z.eq.0) cycle
+       rl(z)=l;rc(z)=ch
+       gv(:,1,z)=ldf(:,l,ch);gv(:,2,z)=lf(:,l,ch)/r
+       fv(:,1,z)=qd(:,l,ch);fv(:,2,z)=qu(:,l,ch)
+       sv(:,1,z)=sdf(:,l,ch);sv(:,2,z)=sf(:,l,ch)/r
+       small(:,z)=sf(:,l,ch)
+    enddo
+ enddo
+ allocate(rad(2,2,nlc,nlc,5),rs(nlc,nlc,2),fun(nr));rad=0.d0;rs=0.d0
+ do q=1,nlc
+    do p=1,nlc
+       do j=1,2
+          do i=1,2
+             fun=r*r*gv(:,i,p)*gv(:,j,q)
+             call charge(r,dx,fun,1,nr,rad(i,j,p,q,1))
+             fun=r*r*gv(:,i,p)*fv(:,j,q)
+             call charge(r,dx,fun,1,nr,rad(i,j,p,q,2))
+             fun=r*r*sv(:,i,p)*sv(:,j,q)
+             call charge(r,dx,fun,1,nr,rad(i,j,p,q,3))
+             if(nat_scale.ne.0.d0) then
+                fun=r*r*fv(:,i,p)*fv(:,j,q)
+                call charge(r,dx,fun,1,nr,rad(i,j,p,q,4))
+             endif
+             if(mass_scale.ne.0.d0) then
+                fun=r*r*r*dvry*fv(:,i,p)*fv(:,j,q)
+                call charge(r,dx,fun,1,nr,rad(i,j,p,q,5))
+             endif
+          enddo
+       enddo
+       if(mass_scale.ne.0.d0) then
+          fun=r*r*r*dvry*small(:,p)*small(:,q)
+          call charge(r,dx,fun,1,nr,rs(p,q,1))
+       endif
+       if(en_scale.ne.0.d0) then
+          fun=r*r*c2inv*small(:,p)*small(:,q)
+          call charge(r,dx,fun,1,nr,rs(p,q,2))
+       endif
+    enddo
+ enddo
+ allocate(angular(nout,3,2,nin),moment(nout2,3,3,2,nin))
+ angular=(0.d0,0.d0);moment=(0.d0,0.d0)
+ do lm=1,nin
+    do k=1,nmap(lm)
+       out=outmap(k,lm)
+       angular(out,:,1,lm)=hmap(:,k,lm)
+       angular(out,:,2,lm)=dmap(:,k,lm)
+    enddo
+ enddo
+ if(mass_scale.ne.0.d0) then
