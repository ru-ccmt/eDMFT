+   ! form of the kinetic discontinuity discussed by Thonhauser et al.:
+   !
+   !   RMT^3 int dOmega n_alpha n_beta psi^* (T_I psi-T_MT psi).
+   !
+   ! It must not be confused with the gradient-density jump above.  For the
+   ! nonrelativistic radial functions, the spherical radial equation gives
+   ! T u=(E_l-V_sph)u and T udot=(E_l-V_sph)udot+u in Rydberg units.  A local
+   ! orbital is a linear combination and generally is not an eigenfunction
+   ! of one radial energy, so its boundary kinetic value is evaluated from
+   ! the stored radial function.  This diagnostic is printed but is not
+   ! applied to the production stress.
+   imax = jri(jatom)
+   do ir=1,imax
+      rmesh(ir) = r0(jatom)*exp(dx(jatom)*(ir-1))
+   enddo
+   vboundary = 2.d0*VR(imax)/rmt
+   tu = 0.d0
+   tue = 0.d0
+   tlo = 0.d0
+   do l0=0,lmax2
+      tu(l0) = (EL(l0)-vboundary)*P(l0)
+      tue(l0) = (EL(l0)-vboundary)*PE(l0) + P(l0)
+      do jlo=1,ilo(l0)
+         if(loor(jlo,l0)) then
+            do ir=1,imax
+               frad(ir) = a1lo(ir,jlo,l0)/rmesh(ir)
+            enddo
+            call dergl(imax,rmesh,frad,dfdr,.true.,g0)
+            call dergl(imax,rmesh,dfdr,d2fdr2,.true.,g0)
+            tlo(jlo,l0) = -d2fdr2(imax) - 2.d0*dfdr(imax)/rmt + &
+                           dble(l0*(l0+1))*frad(imax)/(rmt*rmt)
+         endif
+      enddo
+   enddo
+
+   index = 0
+   do l0 = 0,lmax2
