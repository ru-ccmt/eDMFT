+                  psi_surf(index,num) = psi_surf(index,num) + &
+                       CLM(index,num,jlo)*plo(jlo,l0)
+                  tmt_surf(index,num) = tmt_surf(index,num) + &
+                       CLM(index,num,jlo)*tlo(jlo,l0)
+               endif
+            enddo
+         enddo
+      enddo
+   enddo
    
