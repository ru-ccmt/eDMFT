    real*8              :: CIN,CINP,g0,TC                          
                           
                           
+    ! The published stress formula is nonrelativistic.  Historically these
+    ! radial Pulay integrals were nevertheless evaluated by RINT13 with the
+    ! scalar-relativistic small component added as if it carried the same
+    ! scalar Y_lm angular dependence as the large component.  That is not the
+    ! Koelling-Harmon transformation law: the small component is generated
+    ! by sigma.p acting on the large component.  Keep the historical result
+    ! as the production default while exposing a tightly scoped diagnostic
+    ! that suppresses only this questionable small-component part.  It is
+    ! used to measure the sector before replacing it by the derived
+    ! derivative-generated overlap; NONE is never a production setting.
+    REL_PULAY=REL
+    pulay_small_env=''
+    call get_environment_variable('WIEN_STRESS_RELA_PULAY_SMALL', &
+                                  pulay_small_env, &
+                                  status=pulay_small_status)
+    if(pulay_small_status.eq.0 .and. len_trim(pulay_small_env).gt.0) then
+       select case(trim(adjustl(pulay_small_env)))
+       case('FULL','full')
+          REL_PULAY=REL
+       case('NONE','none','0')
+          REL_PULAY=.false.
+       case default
+          write(6,*) 'Invalid WIEN_STRESS_RELA_PULAY_SMALL: ', &
+                     trim(pulay_small_env)
+          stop 'RELA_PULAY_SMALL must be FULL or NONE'
+       end select
+    endif
+
     CIN = 1.d0/137.0359895d0**2
     CINP = 1.d0/137.0359895d0
     if(.not.REL) CIN = 1E-22                       
