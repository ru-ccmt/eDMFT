+!     Optional finite-difference stress diagnostic.
+!
+!     Analytic LAPW stress differentiates a fixed variational space. A
+!     normal finite-difference calculation rebuilds the spherical |k+G|
+!     cutoff after strain, so plane waves can enter or leave the basis.
+!     The resulting discontinuous energy change can be larger than the
+!     stress error being tested. The marker files below enable a strictly
+!     opt-in, serial-only diagnostic which keeps the integer G-vector list
+!     fixed while the reciprocal lattice is strained:
+!
+!       lapw1.fixgvec.write  present: write lapw1.fixgvec
+!       lapw1.fixgvec.read   present: read  lapw1.fixgvec
+!
+!     Normal production behavior is unchanged when neither marker exists.
+!     Reference and strained runs must have identical k-point ordering,
+!     lattice type, symmetry ordering, and local-orbital definitions.
+      IF (.NOT.FIX_INIT) THEN
+         INQUIRE(FILE='lapw1.fixgvec.write',EXIST=THERE_WRITE)
+         INQUIRE(FILE='lapw1.fixgvec.read', EXIST=THERE_READ)
+         IF (THERE_WRITE .AND. THERE_READ) THEN
+            WRITE(6,*) 'FIXGVEC: both read and write markers exist'
+            STOP 'FIXGVEC marker conflict'
+         ENDIF
+         FIX_WRITE=THERE_WRITE
+         FIX_READ =THERE_READ
+         IF ((FIX_WRITE .OR. FIX_READ) .AND. NPE.NE.1) THEN
+            WRITE(6,*) 'FIXGVEC: diagnostic currently requires serial lapw1'
+            STOP 'FIXGVEC serial only'
+         ENDIF
+         IF (FIX_WRITE) THEN
+            OPEN(91,FILE='lapw1.fixgvec',STATUS='REPLACE', &
+                 ACTION='WRITE',IOSTAT=IOS)
+            IF (IOS.NE.0) STOP 'FIXGVEC cannot open output file'
+            WRITE(91,'(A)') 'LAPW1_FIXGVEC_V1'
+            WRITE(6,*) 'FIXGVEC: writing fixed G-vector reference'
+         ELSEIF (FIX_READ) THEN
+            OPEN(91,FILE='lapw1.fixgvec',STATUS='OLD', &
+                 ACTION='READ',IOSTAT=IOS)
+            IF (IOS.NE.0) STOP 'FIXGVEC cannot open input file'
+            READ(91,'(A)',IOSTAT=IOS) FIX_MAGIC
+            IF (IOS.NE.0 .OR. TRIM(FIX_MAGIC).NE.'LAPW1_FIXGVEC_V1') &
+                 STOP 'FIXGVEC invalid file header'
+            WRITE(6,*) 'FIXGVEC: reading fixed G-vector reference'
