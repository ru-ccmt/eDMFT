+        def select(v):
+            return self.input.unpack(v)[0].copy()
+
+        def select_back(s):
+            y = np.zeros(self.input.size)
+            y[: spherical.input_size] = checked(
+                s, (spherical.input_size,), "spherical covector", real=True
+            )
+            return y
