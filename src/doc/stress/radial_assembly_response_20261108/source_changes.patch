+            compiler,
+            "-O2",
+            "-fcheck=bounds,pointer,mem,do",
+            "-ffpe-trap=invalid,zero,overflow",
+            *map(str, sources),
+            "-o",
+            str(executable),
+        ],
+        cwd=work,
+        capture_output=True,
+        text=True,
+    )
+    (work / "build.log").write_text(build.stdout + build.stderr)
+    build.check_returncode()
+    cases = []
+    n = 401
+    r0, rmt, z = 1e-4, 2.1, 26.0
+    dx = math.log(rmt / r0) / (n - 1)
