+       result(:,3,np+j)=ca(ell,j)*up(:,ell)+cb(ell,j)*dup(:,ell)+cc(ell,j)*upl(:,j,ell)
+       result(:,4,np+j)=ca(ell,j)*bp(:,ell)+cb(ell,j)*dbp(:,ell)+cc(ell,j)*bpl(:,j,ell)
+    enddo
