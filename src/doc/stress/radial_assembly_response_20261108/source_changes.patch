+            "outwin",
+            "outwin_response",
+            "atpar",
+            "rint13",
+            "abc",
+            "diracout",
+            "dergl",
+            "inouh",
+            "inth",
+        ]
+    ]
+    sources += [module, tests / "test_lapw_radial_response.f90"]
+    executable = work / "test_lapw_radial_response"
