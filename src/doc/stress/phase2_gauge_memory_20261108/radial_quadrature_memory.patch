+                lo,
+                w,
+                r,
+                e,
+                el,
+                tri[:, :2],
+                lapw=lapw,
+                cache_products=False,
+                share_radial=True,
+            )
+            self.assertIs(small.phi, p)
+            self.assertIs(small.metric, w)
+            self.assertIsNone(small._kz)
+            self.assertIsNone(small._sz)
+            if not lapw:
