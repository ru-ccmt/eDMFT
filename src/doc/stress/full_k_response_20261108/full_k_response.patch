+def completion(columns):
+    n, nr = columns.shape
+    y = np.zeros((n, n), complex)
+    y[:, :nr] = columns
+    y[:nr, nr:] = columns[nr:].conj().T
+    return y
+
+
+def restrict_channel(ch, nr):
+    ch = copy.copy(ch)
+    ch.fj = ch.fj[:, :nr].copy()
+    ch.dfj = ch.dfj[:, :nr].copy()
+    ch.local = ch.local[:, :, :nr].copy()
+    ch.nband = nr
+    return ch
