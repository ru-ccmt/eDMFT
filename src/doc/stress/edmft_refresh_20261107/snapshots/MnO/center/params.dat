solver              ='CTQMC'         # impurity solver
DCs                 ='exactd'        # double counting scheme / changed
max_dmft_iterations =1               # number of iteration of the dmft-loop only
max_lda_iterations  =100             # number of iteration of the LDA-loop only
finish              = 1              # number of iterations of full charge loop (1 = no charge self-consistency
ntail               =300             # on imaginary axis, number of points in the tail of the logarithmic mesh
cc                  =5e-05           # the charge density precision to stop the LDA+DMFT run
ec                  =5e-05           # the energy precision to stop the LDA+DMFT run
recomputeEF         =0               # Recompute EF in dmft2 step. If recomputeEF = 2, it tries to find an insulating gap. changed
runIMP              = False

# Impurity problem number 0
iparams0={
     "exe"               : ["ctqmc"        , "# Name of the executable"],
     "U"                 : [9.0            , "# Coulomb repulsion (F0) for Mn"], # changed
     "J"                 : [1.14           , "# Hunds coupling  (J) for Mn"],    # changed
     "CoulombF"          : ["'Ising'"      , "# Can be set to Full"],
     "beta"              : [50             , "# Inverse temperature"],
     "svd_lmax"          : [30             , "# We will use SVD basis to expand G, with this cutoff"],
     "M"                 : [5000000.0      , "# Total number of Monte Carlo steps"],
     "mode"              : ["SH"           , "# We will use self-energy sampling, and Hubbard I tail"],
     "nom"               : [300            , "# Number of Matsubara frequency points sampled"],
     "tsample"           : [200            , "# How often to record measurements"],
     "GlobalFlip"        : [1000000        , "# How often to try a global flip"],
     "warmup"            : [300000.0       , "# Warmup number of QMC steps"],
     "nf0"               : [5.0              , "# Nominal occupancy nd for double-counting"],
}
