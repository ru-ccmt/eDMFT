+        self.e = float(energy)
+        self.c = 137.0359895 if relativistic else 1e30
+        self.im = int(match)
+        self.end = int(end)
+        self.nout = int(output_points)
+        self.occ = float(occupation)
+        self.metric = np.array([1.0, 1 / self.c**2])
+        self.out = _CoreTrajectory(
+            self.r,
+            self.v,
+            energy,
