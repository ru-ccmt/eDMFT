+        result[self.layout.pw_offset :] = (
+            self.ir.pullback(z) if reverse else self.ir.action(z)
+        ).view(float)
+        return result
+
+    def action(self, x):
+        return self._map(x, False)
+
+    def pullback(self, x):
+        return self._map(x, True)
