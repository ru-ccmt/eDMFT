+                op.harmonics is None
+                or tuple(key[1:] for key, sl in rows) != op.harmonics
+            ):
+                raise ValueError("XC requires exact signed (l,m) channel ordering")
+            if (
+                len(rows) != op.nl
+                or not np.array_equal([abs(key[1]) for key, sl in rows], abs(op.ells))
