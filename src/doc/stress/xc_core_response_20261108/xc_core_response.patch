+    for change in [
+        dict(end=301),
+        dict(match=200.5),
+        dict(output_points=0),
+        dict(z=140),
+        dict(occupation=np.nan),
+        dict(relativistic="RELA"),
+    ]:
+        with unittest.TestCase().assertRaises(ValueError):
+            MatchedCoreState(r, -1 / r, -0.5, **(args | change))
