+            raise ValueError("invalid vacuum averaging thresholds")
+        self.average_from = (raw / 2 > rho_min[1]) & (raw / 2 < rho_min[0])
+        self.average_to = raw / 2 < rho_min[0]
+        self.average_count = int(np.sum(self.average_from))
