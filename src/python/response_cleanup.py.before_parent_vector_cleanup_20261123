"""Prune regenerable response data only after successful SCF publication.

Call cleanup_response at the end of the successful final-response driver,
after mixer/scfm succeeds. This module never changes physics inputs, parent
vectors, density, Sigma, report files, other response runs, or global scratch.
Set keep_temporary_files=true in case.stress_response.json to retain native
exports for diagnostics. Reports, logs, inputs and a deletion inventory survive
normal cleanup. Errors propagate so the caller can issue a nonfatal warning.
"""
from contextlib import contextmanager
import hashlib
import json
import math
import os
from pathlib import Path, PurePosixPath
import re
import stat
import tempfile
import time

SCHEMA = 1
MANIFEST = 'response_cleanup.json'
RESULT = 'response_cleanup_result.json'

class CleanupError(RuntimeError):
    """Cleanup refused or could not complete; calculation output remains valid."""


def _require(value, message):
    if not value:
        raise CleanupError(message)


def _sha(path):
    fd = os.open(str(path), os.O_RDONLY | getattr(os, 'O_NOFOLLOW', 0))
    try:
        _require(stat.S_ISREG(os.fstat(fd).st_mode), 'not a regular file: '+str(path))
        h = hashlib.sha256()
        with os.fdopen(fd, 'rb', closefd=False) as stream:
            for block in iter(lambda: stream.read(8*1024*1024), b''):
                h.update(block)
        return h.hexdigest()
    finally:
        os.close(fd)


def _atomic(path, value):
    fd, name = tempfile.mkstemp(prefix='.'+path.name+'.', dir=str(path.parent))
    try:
        with os.fdopen(fd, 'w') as out:
            json.dump(value, out, sort_keys=True, separators=(',', ':'))
            out.write('\n'); out.flush(); os.fsync(out.fileno())
        os.chmod(name, 0o600)
        os.replace(name, path)
    finally:
        if os.path.exists(name): os.unlink(name)


def _regular(path):
    _require(not path.is_symlink() and path.is_file(), 'required regular file missing or symlinked: '+str(path))
    return path


def _inside(workspace, path):
    """Accept only canonical paths physically inside the one verified run."""
    p = Path(path)
    _require(p.is_absolute(), 'response path is not absolute')
    try: rel = p.relative_to(workspace)
    except ValueError: raise CleanupError('response path is outside its current workspace')
    _require(rel.parts and all(x not in ('..', '.') for x in rel.parts), 'unsafe response path')
    current = workspace
    for part in rel.parts:
        current = current/part
        _require(not current.is_symlink(), 'symlink in required response path: '+str(current))
    _require(current.resolve(strict=True).is_relative_to(workspace), 'response path escaped workspace')
    return _regular(current)


def _finite(x):
    return type(x) in (int, float) and math.isfinite(x)


def _check_report(report, case, requires_adjoint=False):
    _require(report.get('converged') is True and not report.get('diagnostic_only', False), 'report is not a converged physical result')
    _require(report.get('case', case)==case, 'response report belongs to another case')
    if requires_adjoint:
        _require(isinstance(report.get('adjoint'),dict), 'screened analytic response is missing its adjoint')
    if 'adjoint' in report and report['adjoint'] is not None:
        adj = report['adjoint']
        _require(isinstance(adj, dict) and adj.get('converged') is True, 'adjoint did not converge')
        _require(adj.get('full_frequency_check') is True, 'adjoint full-frequency verification missing')
        residual, threshold = adj.get('residual_norm'), adj.get('threshold')
        _require(_finite(residual) and _finite(threshold) and threshold>0 and 0<=residual<=threshold, 'adjoint residual failed its threshold')


def _guard(case, directory, status, status_path):
    _require(status.get('status')=='complete' and status.get('converged') is True, 'response is not complete/converged')
    run_id = status.get('run_id')
    _require(isinstance(run_id, str) and re.fullmatch(r'[A-Za-z0-9_.-]+', run_id), 'invalid response run id')
    raw = Path(status.get('workspace', ''))
    _require(raw.is_absolute() and raw.name==run_id and not raw.is_symlink(), 'workspace does not identify this run')
    _require(raw.resolve(strict=True)==raw and raw.is_dir(), 'workspace is not canonical or does not exist')
    workspace = raw
    _require(workspace!=directory and not directory.is_relative_to(workspace), 'response workspace contains parent calculation')
    reference = status.get('reference_id')
    _require(isinstance(reference, str) and bool(reference) and '\n' not in reference, 'missing publication reference id')
    published = Path(status.get('published_scf', ''))
    expected = directory/(case+'.scf')
    _regular(expected)
    _require(published.is_absolute() and published==expected and not published.is_symlink(), 'published SCF does not belong to this calculation')
    text = published.read_text()
    witnesses = {str(published):_sha(published)}
    _regular(status_path)
    _require(json.loads(status_path.read_text())==status, 'response status changed')
    witnesses[str(status_path)] = _sha(status_path)
    # Native AStep can report an error without raising. Independently require
    # clean native error files and newly written mixer output before pruning.
    for error in directory.glob('*.error*'):
        _require(not error.is_symlink() and error.is_file() and error.stat().st_size==0,
                 'nonempty or unsafe native error file: '+str(error))
        witnesses[str(error)] = _sha(error)
    scfm = _regular(directory/(case+'.scfm'))
    _require(scfm.stat().st_mtime_ns>=status_path.stat().st_mtime_ns,
             'mixer output predates response publication')
    mixed = scfm.read_text()
    charge = re.search(r'^:DIS(?:\s|:)',mixed,re.M) is not None
    force = status.get('force_applied') is True and re.search(r'^:FGL\d{3}:',mixed,re.M) is not None
    stress = status.get('stress_applied') is True and re.search(r'^:(?:STR(?:ESS)?\d{3}:|STR_(?:TOTAL|VAL|CORE|DENS)\d{3}:)',mixed,re.M) is not None
    _require(charge or force or stress, 'fresh mixer output has no charge/force/stress record')
    witnesses[str(scfm)] = _sha(scfm)
    applied = []
    requires_adjoint=status.get('backend')=='analytic' and status.get('requested_mode') in {'FORT','STRT','STRFT'}
    if status.get('stress_applied') is True: applied.append(('stress','report'))
    if status.get('force_applied') is True: applied.append(('force','force_report'))
    _require(applied, 'response has not been applied')
    for kind, field in applied:
        marker = (':STRRESP_BEGIN: ' if kind=='stress' else ':FORRESP_BEGIN: ')+reference+' '
        _require(marker in text, 'published SCF lacks this response marker: '+kind)
        path = _inside(workspace, status.get(field, ''))
        expected_sha = status.get(field+'_sha256')
        _require(isinstance(expected_sha,str) and re.fullmatch(r'[0-9a-f]{64}',expected_sha), 'missing response report checksum')
        _require(_sha(path)==expected_sha, 'response report checksum mismatch')
        _check_report(json.loads(path.read_text()), case, requires_adjoint)
        witnesses[str(path)] = expected_sha
    # Validate any additional recorded report, even when only force or stress
    # was published. Do not recheck parent_fingerprints here: mixer is allowed
    # to update clmsum and other mutable parent density outputs after assembly.
    for field in ['report','force_report']:
        if status.get(field) and status.get(field+'_sha256'):
            path = _inside(workspace,status[field]);sha=status[field+'_sha256']
            _require(_sha(path)==sha, 'recorded report checksum mismatch')
            _check_report(json.loads(path.read_text()),case,requires_adjoint);witnesses[str(path)]=sha
    status_sha = hashlib.sha256(json.dumps(status,sort_keys=True,separators=(',',':')).encode()).hexdigest()
    return workspace, dict(run_id=run_id,reference_id=reference,status_sha256=status_sha,witnesses=witnesses)


def _relative(value):
    p = PurePosixPath(value)
    _require(not p.is_absolute() and p.parts and all(x not in ('..','.') for x in p.parts) and str(p)==value, 'unsafe inventory path')
    return p


def _group(case, relative):
    rel = _relative(relative)
    # Explicit archival subtrees are never data caches, even inside one run.
    if any(x.lower() in {'eos','eos_archive','eos_archives','archive','archives','fort_tmp'} or x.lower().startswith('eos_archive') for x in rel.parts[:-1]):
        return None
    name = rel.name
    patterns = [
        (r'native\.k\d{8}\.bin(?:\.gz)?', 'native_basis_overlap'),
        (r'native\.ham\.k\d{8}\.bin(?:\.gz)?', 'native_hamiltonian'),
        (r'response(?:_dn)?\.k\d{8}\.bin(?:\.gz)?', 'response_states'),
        (r'response(?:_dn)?\.operator\.k\d{8}\.bin(?:\.gz)?', 'response_operator_states'),
        (r'response(?:_dn)?\.spin(?:\.gz)?', 'spin_export'),
        (re.escape(case)+r'\.vector(?:so(?:dn|up)?|dn|up)?(?:_\d+)?(?:\.gz)?', 'workspace_vectors'),
    ]
    for pattern,group in patterns:
        if re.fullmatch(pattern,name): return group
    return None


def _inventory(workspace, case):
    files=[];preserved=dict(unknown_files=0,symlinks=0,hardlinks=0,nonregular=0)
    for directory,dirs,names in os.walk(workspace,followlinks=False):
        here=Path(directory)
        for name in list(dirs):
            p=here/name
            if p.is_symlink():preserved['symlinks']+=1;dirs.remove(name)
            elif name.lower() in {'eos','eos_archive','eos_archives','archive','archives','fort_tmp'} or name.lower().startswith('eos_archive'):
                dirs.remove(name)
        for name in names:
            p=here/name;rel=str(p.relative_to(workspace));s=p.lstat()
            if stat.S_ISLNK(s.st_mode):preserved['symlinks']+=1;continue
            if not stat.S_ISREG(s.st_mode):preserved['nonregular']+=1;continue
            if s.st_nlink!=1:preserved['hardlinks']+=1;continue
            group=_group(case,rel)
            if group is None:preserved['unknown_files']+=1;continue
            files.append(dict(path=rel,bytes=s.st_size,sha256=_sha(p),group=group,device=s.st_dev,inode=s.st_ino,mtime_ns=s.st_mtime_ns))
    files.sort(key=lambda x:(-x['bytes'],x['path']))
    return files,preserved


@contextmanager
def _lock(workspace):
    path=workspace/'.response_cleanup.lock'
    try:fd=os.open(str(path),os.O_CREAT|os.O_EXCL|os.O_WRONLY|getattr(os,'O_NOFOLLOW',0),0o600)
    except FileExistsError:raise CleanupError('another cleanup lock exists; manual inspection required')
    try:os.close(fd);yield
    finally:path.unlink()


@contextmanager
def _parent_fd(workspace,relative):
    parts=_relative(relative).parts
    fd=os.open(str(workspace),os.O_RDONLY|os.O_DIRECTORY|getattr(os,'O_NOFOLLOW',0))
    try:
        for part in parts[:-1]:
            nxt=os.open(part,os.O_RDONLY|os.O_DIRECTORY|getattr(os,'O_NOFOLLOW',0),dir_fd=fd);os.close(fd);fd=nxt
        yield fd,parts[-1]
    finally:os.close(fd)


def _same_file(s,item):
    return stat.S_ISREG(s.st_mode) and s.st_nlink==1 and (s.st_dev,s.st_ino,s.st_size,s.st_mtime_ns)==(item['device'],item['inode'],item['bytes'],item['mtime_ns'])


def cleanup_response(case, directory='.', status=None):
    """Remove only regenerable files in one successfully published response run.

    Returns a small result/skip dictionary. On safety or storage failures raises
    CleanupError/OSError; callers should warn and retain the valid calculation.
    A missing/unapplied response is ordinary workflow and simply returns skip.
    """
    _require(isinstance(case,str) and bool(case) and case not in {'.','..'} and Path(case).name==case and '/' not in case and '\\' not in case, 'invalid case name')
    directory=Path(directory).expanduser().resolve(strict=True)
    status_path=directory/(case+'.stress_response.status.json')
    if status is None:
        if not status_path.exists(): return dict(status='skipped',reason='no_response_status')
        status=json.loads(_regular(status_path).read_text())
    _require(isinstance(status,dict), 'response status must be an object')
    keep=status.get('keep_temporary_files',False)
    _require(type(keep) is bool, 'keep_temporary_files must be a boolean')
    if keep:return dict(status='skipped',reason='keep_temporary_files')
    if not (status.get('force_applied') is True or status.get('stress_applied') is True):
        return dict(status='skipped',reason='response_not_applied')
    workspace,guard=_guard(case,directory,status,status_path)
    with _lock(workspace):
        manifest_path=workspace/MANIFEST;result_path=workspace/RESULT
        if manifest_path.exists() or result_path.exists():
            _regular(manifest_path);_regular(result_path)
            old=json.loads(manifest_path.read_text());result=json.loads(result_path.read_text())
            _require(result.get('complete') is True and result.get('manifest_sha256')==_sha(manifest_path), 'prior incomplete cleanup must be reviewed')
            _require(old.get('case')==case and old.get('workspace')==str(workspace) and old.get('guard')==guard, 'prior cleanup belongs to different publication')
            remaining,_=_inventory(workspace,case)
            _require(not remaining, 'new regenerable files appeared after cleanup')
            return dict(status='already_cleaned',removed_files=0,removed_bytes=0,manifest=str(manifest_path))
        files,preserved=_inventory(workspace,case)
        _require(_guard(case,directory,status,status_path)[1]==guard, 'publication changed during inventory')
        # Verify every candidate before deleting any of them. Unknown paths,
        # symlinks, hard links and another run can never enter this inventory.
        for item in files:
            p=_inside(workspace,workspace/item['path'])
            _require(_group(case,item['path'])==item['group'] and _same_file(p.lstat(),item), 'regenerable file changed during inventory')
            _require(_sha(p)==item['sha256'], 'regenerable data changed during inventory')
        manifest=dict(schema=SCHEMA,case=case,workspace=str(workspace),created_epoch=time.time(),guard=guard,files=files,preserved=preserved)
        _atomic(manifest_path,manifest)
        _require(_guard(case,directory,status,status_path)[1]==guard, 'publication or mixer output changed before deletion')
        removed=[]
        try:
            for item in files:
                with _parent_fd(workspace,item['path']) as (fd,name):
                    _require(_same_file(os.stat(name,dir_fd=fd,follow_symlinks=False),item), 'regenerable data changed before unlink')
                    os.unlink(name,dir_fd=fd)
                removed.append(item['path'])
        finally:
            removed_set=set(removed)
            _atomic(result_path,dict(schema=SCHEMA,finished_epoch=time.time(),manifest_sha256=_sha(manifest_path),complete=len(removed)==len(files),removed_files=len(removed),removed_bytes=sum(x['bytes'] for x in files if x['path'] in removed_set)))
        _require(_guard(case,directory,status,status_path)[1]==guard, 'retained publication witnesses changed')
        return dict(status='cleaned',removed_files=len(removed),removed_bytes=sum(x['bytes'] for x in files),manifest=str(manifest_path))
